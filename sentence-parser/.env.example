# 复制为 .env 后按需填写；网页「设置」里保存的值会覆盖这里的默认值。

# 墨墨背单词开放 API Token（App →「我的」→「更多设置」→「实验功能」→「开放 API」）
MAIMEMO_TOKEN=

# AI 模型：anthropic（默认）或 openai（任何兼容 OpenAI 接口的服务，如 DeepSeek、通义千问）
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# 默认难度：kaoyan1 / kaoyan2 / cet4 / cet6 / ielts / toefl / gre
EXAM_LEVEL=kaoyan1

# 服务地址；默认只允许本机访问
HOST=127.0.0.1
PORT=5173
